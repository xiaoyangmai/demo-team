#!/bin/sh
exec python3 - <<'PY'
"""Read-only facts for Self-Evolution; never score artifacts or choose candidates."""
import hashlib
import json
from pathlib import Path
import subprocess
import yaml

root = Path('/opt/data/profiles/frontend')
config = yaml.safe_load((root / 'config.yaml').read_text())
files = [root / 'SOUL.md', root / 'config.yaml']
files += sorted(p for p in (root / 'skills').rglob('*') if p.is_file() and p.name != '.usage.json' and not p.is_symlink())
files += sorted(p for p in (root / 'memories').rglob('*') if p.is_file() and not p.is_symlink())
checks = {'background_review_disabled': config.get('auxiliary', {}).get('background_review', {}).get('enabled', True) is False,
          'code_execution_disabled': 'code_execution' in config.get('agent', {}).get('disabled_toolsets', [])}
print(json.dumps({'ready': all(checks.values()), 'checks': checks,
                  'revision': subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
                  'files': {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in files if p.is_file()}}))
PY
